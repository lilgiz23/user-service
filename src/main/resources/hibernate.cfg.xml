<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Драйвер базы данных -->
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>

        <!-- Адрес базы: localhost:5432/имя_базы -->
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/userservice</property>

        <!-- Твой логин в PostgreSQL -->
        <property name="hibernate.connection.username">ilgiz</property>

        <!-- Автосоздание таблиц (update) -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Подключаем наш класс User -->
        <mapping class="org.example.entity.User"/>
    </session-factory>
</hibernate-configuration>